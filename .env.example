# --- Cloud API Options (set whichever provider you are running) ---
# Option 1: Paid OpenAI API (e.g., for Partner B's OpenAI account / team benchmark)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Groq API (used during service-side runs)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Local / Hosted Ollama Option ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b